#!/usr/bin/env bash
set -euo pipefail

# shipit verify [commit]: say whether a check receipt exists for the content of
# a commit. With no argument: HEAD, and the working tree must be clean. The
# setup is the one committed at that commit. Exit 0 valid receipt, 1 no valid
# receipt or uncommitted changes, 2 usage or setup error. Writes and creates
# nothing.

# shellcheck source=../lib/common.sh
source "$SHIPIT_ROOT/lib/common.sh"
# shellcheck source=../lib/setup.sh
source "$SHIPIT_ROOT/lib/setup.sh"
# shellcheck source=../lib/store.sh
source "$SHIPIT_ROOT/lib/store.sh"

readonly USAGE='usage: shipit verify [commit]'

# read_receipt <path>: print the receipt as compact JSON, or null when the file
# is missing, unreadable, empty, not JSON, or holds more than one value.
read_receipt() {
  local out
  if [[ -f $1 && -r $1 ]] &&
    out=$(jq -c -s 'if length == 1 then .[0] else null end' "$1" 2>/dev/null); then
    printf '%s\n' "$out"
  else
    printf 'null\n'
  fi
}

main() {
  local target=HEAD explicit=
  case $# in
    0) ;;
    1)
      explicit=1
      target=$1
      ;;
    *) die 2 "too many arguments; $USAGE" ;;
  esac
  [[ -z $explicit || -n $target ]] || die 2 "empty commit; $USAGE"

  local top
  top=$(repo_top) || exit
  cd "$top"

  git rev-parse --verify --quiet --end-of-options "$target^{commit}" >/dev/null ||
    die 2 "'$target' is not a commit; give a branch, tag or commit"
  load_setup "$target" >/dev/null || exit

  if [[ -z $explicit ]]; then
    local dirty
    dirty=$(git status --porcelain --untracked-files=normal) || die 2 "cannot read the git status"
    [[ -z $dirty ]] ||
      die 1 "uncommitted changes: commit first, a receipt is per commit content"
  fi

  local tree receipt_path receipt verdict short reason ok
  tree=$(git rev-parse --verify --end-of-options "$target^{tree}") || exit
  receipt_path=$(store_path "receipts/check/$tree.json") || exit
  receipt=$(read_receipt "$receipt_path") || exit
  # shellcheck disable=SC2016 # $tree is a jq variable, bound by --arg
  verdict=$(printf '%s\n' "$receipt" |
    jq_lib -c --arg tree "$tree" 'include "check_receipt"; check_receipt_valid($tree)') || exit
  ok=$(printf '%s\n' "$verdict" | jq -r '.ok') || exit
  if [[ $ok == true ]]; then
    short=$(git rev-parse --short "$tree") || exit
    printf 'valid receipt for %s\n' "$short"
  else
    reason=$(printf '%s\n' "$verdict" | jq -r '.reason') || exit
    die 1 "$reason"
  fi
}

main "$@"
